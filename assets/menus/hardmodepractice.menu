cut 8 8
center
title "Hardmode Practice"
text "Practice does not affect run progress or completion."
text "Activate both buttons in a world to unlock its practice levels."
foreach practice_levels
when row.unlocked
button "Level ${row.number}" hardmode_practice "${row.number}"
otherwise
text "Level ${row.number} - World ${row.world} locked"
endwhen
endfor
snap center bottom
button "Back" menu hardmode
