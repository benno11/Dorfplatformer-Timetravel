cut 8 7
center
title "Local Levels"
text "Filter: ${level_filter_label}  Page ${level_page_number}/${level_page_count}"
text "${local_level_status}"
text "${level_detail_status}"
button "Create" create_level
foreach levels
button "${row.label}" level_detail "local:${row.index}"
endfor
when levels_empty
when levels_loading
text "Loading online levels..."
otherwise
text "No levels match this filter."
endwhen
endwhen
snap bottom left
button "Refresh" refresh_levels local
button "Previous Page" level_page local:prev
button "Next Page" level_page local:next
button "Filter: All" level_filter local:all
snap bottom right
button "Filter: Easy" level_filter local:easy
button "Filter: Medium" level_filter local:medium
button "Filter: Hard" level_filter local:hard
button "Filter: Unrated" level_filter local:unrated
snap center bottom
button "Back" menu mainedit
