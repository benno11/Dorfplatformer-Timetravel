# DF Slim Menu: display settings
title "Display Settings"
button "Fullscreen: ${fullscreen}" toggle fullscreen
button "VSync: ${vsync_enabled}" toggle vsync_enabled
button "Native Text Resolution: ${native_text_resolution_enabled}" toggle native_text_resolution_enabled
button "UI Scale + (${ui_scale_percent}%)" inc ui_scale_percent
button "UI Scale - (${ui_scale_percent}%)" dec ui_scale_percent
button "UI Edge Padding + (${ui_edge_padding})" inc ui_edge_padding
button "UI Edge Padding - (${ui_edge_padding})" dec ui_edge_padding
button "Back" menu mainsetting
