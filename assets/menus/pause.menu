title "PAUSED"
control resume "RESUME" resume "" Continuebtn
control restart "RESTART" restart "" Retartbtn
control quit "QUIT" quit "" exitbtn
control settings "S" menu mainsetting settingbtn
set panel_sprite Panel
set panel_width 400
set panel_height 280
set button_scale 0.75
set fallback_width 360
set fallback_height 220
set fallback_button_width 70
set fallback_button_height 30
set fallback_button_gap 8

control pause "PAUSE" pause

set loading "Loading game..."

control music "Music" music_volume
control sfx "SFX" sfx_volume

set controls_top 76
set fallback_controls_top 62
