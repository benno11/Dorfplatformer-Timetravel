cut 8 8
center
title "Achievements"
snap center top
text "${achievement_unlocked}/${achievement_count} unlocked"
text "Shared across all save slots."
center
foreach achievements


when row.unlocked
button "${row.title}" copy "${row.title}"
otherwise
button "${row.requirements}" copy "${row.requirements}"
endwhen


endfor


snap center bottom
button "Back" back
