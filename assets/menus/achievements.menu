cut 8 8
center
title "Achievements"
snap center top
text "${achievement_unlocked}/${achievement_count} unlocked"
text "Shared across all save slots."
center
foreach achievements
button "[${row.state}] ${row.title}" menu "achievement:${row.id}"
endfor
text "World buttons: activate the buttons in areas 1 and 2."
snap left bottom
button "Back" back
