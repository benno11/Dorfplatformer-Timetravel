{
  "name": "Dorfplatformer custom game server",
  "type": "self-hosted",
  "storage": "SQLite",
  "api_version_id": 1,
  "level_server_url": "",
  "account_manager_url": "/",
  "auth": "Bearer session token",
  "level_read_contract": {
    "list_ids": "/levels.json?shallow=true",
    "fetch_level_data": "/levels/<id>/data.json"
  },
  "level_write_contract": {
    "put_level_object": "/levels/<id>.json",
    "delete_level": "/levels/<id>.json",
    "required_fields": ["name", "data"]
  }
}
