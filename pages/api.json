{
  "name": "Dorfplatformer custom game server",
  "type": "self-hosted",
  "storage": "SQLite",
  "api_version_id": 1,
  "level_server_url": "",
  "account_manager_url": "/",
  "auth": "Bearer session token",
  "level_read_contract": {
    "list_ids": "/levels.json?shallow=true",
    "fetch_level_data": "/levels/<id>/data.json"
  },
  "level_write_contract": {
    "put_level_object": "/levels/<id>.json",
    "delete_level": "/levels/<id>.json",
    "vote_level": "/levels/<id>/vote",
    "required_fields": ["name", "data"]
  },
  "level_metadata_fields": {
    "downloads": "Incremented by GET /levels/<id>/data.json",
    "likes": "Signed-in user votes",
    "dislikes": "Signed-in user votes"
  }
}
