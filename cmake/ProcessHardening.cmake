# Compiler/runtime control-flow defenses complement the OS sandbox. They do
# not turn a native mod into an untrusted plugin or authenticate all pointers.
include(CheckCXXCompilerFlag)
include(CheckCXXSourceCompiles)
function(platformer_harden_process target)
  if(MSVC)
    target_compile_options(${target} PRIVATE /GS /sdl)
    # XFG adds function-type hashes at indirect calls on supporting MSVC/OSes;
    # CFG remains the baseline on all Windows builds.
    check_cxx_compiler_flag("/guard:xfg" PLATFORMER_COMPILER_XFG)
    if(PLATFORMER_COMPILER_XFG)
      target_compile_options(${target} PRIVATE /guard:xfg)
      target_link_options(${target} PRIVATE /guard:xfg)
    endif()
    if(CMAKE_SIZEOF_VOID_P EQUAL 8)
      set(CMAKE_REQUIRED_LINK_OPTIONS /CETCOMPAT)
      check_cxx_source_compiles("int main(){return 0;}" PLATFORMER_LINKER_CET)
      unset(CMAKE_REQUIRED_LINK_OPTIONS)
      if(PLATFORMER_LINKER_CET)
        target_link_options(${target} PRIVATE /CETCOMPAT)
      endif()
    endif()
  else()
    check_cxx_compiler_flag("-fstack-protector-strong" PLATFORMER_STACK_PROTECTOR)
    if(PLATFORMER_STACK_PROTECTOR)
      target_compile_options(${target} PRIVATE -fstack-protector-strong)
    endif()
    check_cxx_compiler_flag("-fcf-protection=full" PLATFORMER_CET)
    if(PLATFORMER_CET)
      target_compile_options(${target} PRIVATE -fcf-protection=full)
    endif()
    check_cxx_compiler_flag("-mbranch-protection=standard" PLATFORMER_ARM_BRANCH_PROTECTION)
    if(PLATFORMER_ARM_BRANCH_PROTECTION)
      target_compile_options(${target} PRIVATE -mbranch-protection=standard)
    endif()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR ANDROID)
      target_link_options(${target} PRIVATE -Wl,-z,relro,-z,now,-z,noexecstack)
    endif()
    if(CMAKE_CXX_COMPILER_ID MATCHES "Clang" AND NOT APPLE AND NOT WIN32 AND (NOT ANDROID OR CMAKE_SYSTEM_VERSION VERSION_GREATER_EQUAL 26))
      # Cross-DSO mode retains compatibility with native mods. Instrumented
      # mods get type checks; legacy uninstrumented DSOs remain compatible.
      set(CMAKE_REQUIRED_FLAGS "-flto -fsanitize=cfi-icall -fsanitize-cfi-cross-dso")
      check_cxx_source_compiles("int f(int x){return x;} int main(){int (*volatile p)(int)=f;return p(0);}" PLATFORMER_CROSS_DSO_CFI)
      unset(CMAKE_REQUIRED_FLAGS)
      if(PLATFORMER_CROSS_DSO_CFI)
        target_compile_options(${target} PRIVATE -flto -fsanitize=cfi-icall -fsanitize-cfi-cross-dso -fno-sanitize-recover=cfi)
        target_link_options(${target} PRIVATE -flto -fsanitize=cfi-icall -fsanitize-cfi-cross-dso -fno-sanitize-recover=cfi)
      endif()
    endif()
  endif()
endfunction()
